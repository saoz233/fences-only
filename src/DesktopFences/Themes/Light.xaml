<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== 浅色主题色板 ===== -->

    <!-- 栅栏容器背景（半透明，实际透明度由代码按设置动态调整 A 通道） -->
    <Color x:Key="FenceBackgroundColor">#F2F3F5</Color>
    <SolidColorBrush x:Key="FenceBackgroundBrush" Color="#D8F2F3F5" />

    <!-- 标题栏背景 -->
    <SolidColorBrush x:Key="FenceTitleBackgroundBrush" Color="#E6FFFFFF" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#33000000" />

    <!-- 强调色（Win11 蓝） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />

    <!-- 图标 hover / 选中高亮 -->
    <SolidColorBrush x:Key="IconHoverBrush" Color="#330067C0" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1A000000" />

    <!-- 设置窗口背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF6F7F9" />
</ResourceDictionary>
