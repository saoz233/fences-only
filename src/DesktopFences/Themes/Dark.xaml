<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== 深色主题色板（键名与浅色保持一致，运行时整体替换） ===== -->

    <Color x:Key="FenceBackgroundColor">#1F1F1F</Color>
    <SolidColorBrush x:Key="FenceBackgroundBrush" Color="#D81F1F1F" />

    <SolidColorBrush x:Key="FenceTitleBackgroundBrush" Color="#E62B2B2B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0" />

    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />

    <SolidColorBrush x:Key="IconHoverBrush" Color="#334CC2FF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#22FFFFFF" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
</ResourceDictionary>
