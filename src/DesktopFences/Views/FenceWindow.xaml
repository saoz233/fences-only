<Window x:Class="DesktopFences.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:DesktopFences.Helpers"
        xmlns:vm="clr-namespace:DesktopFences.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:FenceViewModel}"
        Title="Fence"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="{DynamicResource FenceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource FenceTitleBackgroundBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 标题（双击文字进入重命名） -->
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Title}"
                               Visibility="{Binding IsEditingTitle, Converter={StaticResource InvBoolToVis}}"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown" />

                    <!-- 重命名编辑框 -->
                    <TextBox x:Name="TitleEdit"
                             Grid.Column="0"
                             VerticalAlignment="Center"
                             FontSize="13"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="{DynamicResource AccentBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVis}}"
                             KeyDown="TitleEdit_KeyDown"
                             LostFocus="TitleEdit_LostFocus" />

                    <!-- 标题栏按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE710;"
                                FontFamily="Segoe MDL2 Assets"
                                ToolTip="折叠/展开"
                                Style="{StaticResource TitleButtonStyle}"
                                Command="{Binding ToggleRollUpCommand}" />
                        <Button Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                ToolTip="删除此栅栏"
                                Style="{StaticResource TitleButtonStyle}"
                                Command="{Binding DeleteFenceCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 图标内容区（折叠时隐藏） ===== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsRolledUp, Converter={StaticResource InvBoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="76" Height="74" Margin="2"
                                        CornerRadius="6"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Item_PreviewMouseMove">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开"
                                                      Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="从栅栏移除"
                                                      Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource IconHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" Margin="2">
                                        <Image Source="{Binding Icon}"
                                               Width="32" Height="32"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="70"
                                                   MaxHeight="28"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空栅栏提示 -->
                <TextBlock Text="把桌面图标拖到这里"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 右下角缩放把手 -->
                <Thumb x:Name="ResizeThumb"
                       Width="14" Height="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       Opacity="0.5"
                       DragDelta="ResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Path Data="M 12,0 L 12,12 L 0,12 Z"
                                  Fill="{DynamicResource TextSecondaryBrush}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</Window>
