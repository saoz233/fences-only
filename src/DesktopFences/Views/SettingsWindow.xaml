<Window x:Class="DesktopFences.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DesktopFences.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="桌面栅栏 · 设置"
        Width="380" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="设置"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">

            <!-- 主题 -->
            <TextBlock Text="主题"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton Content="浅色" GroupName="theme" Margin="0,0,20,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             IsChecked="{Binding IsLight}" />
                <RadioButton Content="深色" GroupName="theme" Margin="0,0,20,0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             IsChecked="{Binding IsDark}" />
                <RadioButton Content="跟随系统" GroupName="theme"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             IsChecked="{Binding IsSystem}" />
            </StackPanel>

            <!-- 透明度 -->
            <TextBlock Text="栅栏透明度"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />
            <Slider Minimum="0.2" Maximum="1.0"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    Value="{Binding Opacity}"
                    Margin="0,0,0,20" />

            <!-- 开机自启 -->
            <CheckBox Content="开机自动启动"
                      FontSize="14"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      IsChecked="{Binding AutoStart}"
                      Margin="0,0,0,12" />

            <!-- 桌面右键菜单 -->
            <CheckBox Content="在桌面空白处右键菜单显示“新建栅栏”"
                      FontSize="14"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      IsChecked="{Binding ShowDesktopMenu}"
                      Margin="0,0,0,20" />

            <!-- 快捷操作 -->
            <TextBlock Text="操作"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="新建栅栏"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,12,0"
                        Command="{Binding NewFenceCommand}" />
                <Button Content="显示/隐藏全部"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ToggleVisibleCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="提示：双击桌面空白处可一键显示/隐藏全部栅栏。"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</Window>
